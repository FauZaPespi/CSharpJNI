<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PublishAot>True</PublishAot>
    <NativeLib>Shared</NativeLib>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
  </ItemGroup>

  <!--
    Native DLLs embedded in PureJNI.dll and extracted at runtime by Core/NativeDeps.cs, so the release is a single file.
    LogicalName must match the names used in NativeDeps.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Native\libs\minhook.x64.dll" LogicalName="native.minhook.x64.dll" />
    <EmbeddedResource Include="$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))hexa.net.imgui\2.2.9\runtimes\win-x64\native\cimgui.dll" LogicalName="native.cimgui.dll" />
    <EmbeddedResource Include="$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))hexa.net.imgui.backends\1.0.18\runtimes\win-x64\native\ImGuiImpl.dll" LogicalName="native.ImGuiImpl.dll" />
  </ItemGroup>

  <!-- They are embedded: don't copy them next to PureJNI.dll on publish. -->
  <Target Name="ExcludeEmbeddedNativesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'cimgui.dll' or '%(Filename)%(Extension)' == 'ImGuiImpl.dll'" />
    </ItemGroup>
  </Target>

  <!--
    NativeAOT finds link.exe via findvcvarsall.bat, which runs vcvarsall.bat in a cmd that inherits the caller's
    environment. With a long PATH (e.g. a Visual Studio terminal started before a PATH change), cmd fails with
    "La ligne entrée est trop longue" (exit 255), which the ILCompiler targets silently ignore: link then runs
    without the MSVC/SDK lib directories (LNK1104 LIBCMT.lib, LNK1181 advapi32.lib).
    Run findvcvarsall.bat ourselves with a minimal environment so the build no longer depends on the terminal.
  -->
  <Target Name="FindVCVarsWithCleanEnvironment" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT' and '$(IlcUseEnvironmentalTools)' != 'true' and '$(ILCompilerTargetsPath)' != ''">
    <PropertyGroup>
      <_CleanVCVarsPath>$(SystemRoot)\System32%3B$(SystemRoot)%3B$(SystemRoot)\System32\WindowsPowerShell\v1.0%3B$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer</_CleanVCVarsPath>
    </PropertyGroup>

    <Exec Command="&quot;$([System.IO.Path]::GetDirectoryName($(ILCompilerTargetsPath)))\findvcvarsall.bat&quot; $(_targetArchitecture)" EnvironmentVariables="PATH=$(_CleanVCVarsPath);LIB=;LIBPATH=;INCLUDE=;__VSCMD_PREINIT_PATH=;NoDefaultCurrentDirectoryInExePath=" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CleanVCVarsOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_CleanVCVarsExitCode" />
    </Exec>

    <Error Condition="'$(_CleanVCVarsExitCode)' != '0'" Text="findvcvarsall.bat a échoué (code $(_CleanVCVarsExitCode)) : $(_CleanVCVarsOutput). Vérifie que la charge de travail 'Développement Desktop en C++' de Visual Studio est installée." />

    <!-- Skip the stock call in SetupOSSpecificProps and hand it our result instead. -->
    <PropertyGroup>
      <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
      <CppLinker>$(_CleanVCVarsOutput.Split(`#`)[0])link.exe</CppLinker>
      <CppLibCreator>$(_CleanVCVarsOutput.Split(`#`)[0])lib.exe</CppLibCreator>
    </PropertyGroup>
    <ItemGroup>
      <AdditionalNativeLibraryDirectories Include="$(_CleanVCVarsOutput.Split(`#`)[1].Split(';'))" />
    </ItemGroup>
  </Target>

</Project>